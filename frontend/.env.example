# DuoSigna Frontend Configuration
# Copy this file to .env and fill in your values

# Backend API base URL
# Local development: http://127.0.0.1:8000
# Production: https://your-cloud-run-service.run.app
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Google Tag Manager Web Container ID (client-side, $0 free tier)
# Leave empty in local development to safely no-op GTM script injection
NUXT_PUBLIC_GTM_ID=

# Set to true locally to log sanitized dataLayer events to the browser console
NUXT_PUBLIC_ANALYTICS_DEBUG=false
